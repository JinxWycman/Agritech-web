# Mock is the safe default; it makes no backend requests.
NEXT_PUBLIC_DATA_MODE=mock

# Required only for NEXT_PUBLIC_DATA_MODE=api. No trailing slash.
NEXT_PUBLIC_API_BASE_URL=https://your-api-host.example.com

# Optional deterministic mock request delay (0-2000 milliseconds).
NEXT_PUBLIC_MOCK_DELAY_MS=80
